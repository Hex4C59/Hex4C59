{{- $index := slice -}}
{{- range partialCached "site/articles.html" site -}}
  {{- $index = $index | append (dict "title" .Title "permalink" .RelPermalink "summary" (.Description | default .Summary | plainify | htmlUnescape) "content" .Plain "tags" (.Params.tags | default slice) "series" (.Params.series | default slice) "date" (.Date.Format "2006-01-02") "section" .Section "categories" (partial "site/categories.html" .) "source_kind" (partial "site/source.html" .)) -}}
{{- end -}}
{{- $index | jsonify -}}
